{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": false,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "cesium": ["./node_modules/cesium"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "test/**/*.js"],
  "exclude": ["node_modules"]
}
